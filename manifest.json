{
  "manifest_version": 3,
  "name": "Letterboxd Pelis Recommendation",
  "version": "3.1.0",
  "description": "Encuentra tu próxima peli favorita exprimiendo los datos públicos de Letterboxd: los fans de tus pelis favoritas y sus top 4.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "Abrir Letterboxd Pelis Recommendation",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://letterboxd.com/*",
    "https://www.letterboxd.com/*"
  ],
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/luchofariello/letterbox-pelis-recomendation"
}
